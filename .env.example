PORT=3001
ELEVENLABS_API_KEY=your_elevenlabs_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
TELEGRAM_BOT_TOKEN=1234567890:your_main_bot_token
# Токен @VoiceStudioSupportBot, если он отдельный от основного бота. Webhook: POST /webhook/support-bot
SUPPORT_BOT_TOKEN=
SUPPORT_GROUP_CHAT_ID=-1001234567890
# URL Mini App в BotFather (Main App) — нужен для справки и фоллбека
MINI_APP_URL=https://your-app.vercel.app
# Direct link из BotFather (t.me/.../app) — ОБЯЗАТЕЛЬНО для web_app-кнопок, чтобы на iPhone было как кнопка «Открыть»
MINI_APP_TELEGRAM_LINK=https://t.me/your_bot_username/app
